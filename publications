<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="images/commit_icon.ico" type="image/x-icon">
    <title>CommIT - Research Group</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>
   <header>
        <img src="images/commit_logo.png" alt="CommIT Logo" id="logo">
        <h1>CommIT</h1>
        <p>Research Group</p>
    </header>
    <nav>
        <ul>
            <li><a href="index.html">Home</a></li>
            <li><a href="research_lines.html">Research Lines</a></li>
            <li><a href="members.html">Members</a></li>
