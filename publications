            <li><a href="#projects">Projects</a></li>
            <li><a href="#tools">Tools</a></li>
            <li><a href="#collaborations">Collaborations</a></li>
            <li><a href="#docencia">Subjects</a></li>-->
        </ul>
    </nav>
    <main>
<section id="selected-publications">
    <h2>Selected Publications</h2>
    <div class="publications-list">
        {% for pub in site.data.publications %}
            {% if pub.highlight %}
            <div class="pub-card">
                <a href="{{ pub.url }}" class="pub-title" target="_blank">{{ pub.title }}</a>
                <span class="pub-authors">{{ pub.authors }}</span><br>
                <span class="pub-venue">{{ pub.venue }}</span> | <span class="pub-year">{{ pub.year }}</span>
            </div>
            {% endif %}
        {% endfor %}
    </div>
    <p style="margin-top: 20px;">
        <a href="https://orcid.org/TU_ORCID" target="_blank" style="color: var(--urjc-red); text-decoration: none; font-weight: bold;">
            View full list on ORCID →
        </a>
    </p>
</section>
    </main>
    <footer>
        <p>&copy; 2024 CommIT - Research Group</p>
    </footer>
</body>
</html>

